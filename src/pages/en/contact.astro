---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { DEFAULT_DATE_PUBLISHED, DEFAULT_LASTMOD, getContactEmail } from '../../data/site';

const breadcrumbs = [{ name: 'TarotMind', path: '/en/' }, { name: 'Advertising', path: '/en/contact/' }];
const email = getContactEmail();
---
<Layout locale="en" title="Advertising | TarotMind" description="Advertising inquiries and contact information for TarotMind." canonicalPath="/en/contact/" pageType="ContactPage" breadcrumbs={breadcrumbs} datePublished={DEFAULT_DATE_PUBLISHED} dateModified={DEFAULT_LASTMOD}>
  <Breadcrumbs items={breadcrumbs} ariaLabel="Breadcrumb" />
  <article class="container readable-content page-hero">
    <span class="eyebrow">Advertising</span>
    <h1>Advertising & Contact</h1>
    <p>Information regarding banner advertising, partnerships, and general inquiries for TarotMind.</p>

    <section class="content-section">
      <h2>Banner Advertising & Inquiries</h2>
      <p>For ad placements, business proposals, or general inquiries regarding TarotMind, please reach out to us via email.</p>

      <div class="contact-box">
        <div class="contact-email">
          <span class="email-label">Email:</span>
          <a href={`mailto:${email}`} class="email-link" id="contact-email">{email}</a>
        </div>
        <div class="contact-actions">
          <a href={`mailto:${email}`} class="primary-button">Send Email</a>
          <button type="button" class="secondary-button" id="copy-email-btn" data-email={email}>Copy Email</button>
        </div>
      </div>

      <h2>Guidelines for Inquiries</h2>
      <ul>
        <li>Including preferred ad placements (top banner, bottom banner) and requested campaign durations will help us respond faster.</li>
        <li>We aim to respond within 1 to 2 business days.</li>
        <li>Because this is a database-free static site, a server-stored contact form is not provided. Your email service’s own policy applies when you send an email.</li>
      </ul>
    </section>
  </article>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = originalText;
          }, 2000);
        } catch (err) {
          alert('Failed to copy email address: ' + email);
        }
      });
    }
  </script>
</Layout>
