---
import Layout from '../components/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { DEFAULT_DATE_PUBLISHED, DEFAULT_LASTMOD, getContactEmail } from '../data/site';

const breadcrumbs = [{ name: '타로마음', path: '/' }, { name: '광고문의', path: '/contact/' }];
const email = getContactEmail();
---
<Layout title="광고문의 | 타로마음" description="타로마음 광고 문의, 배너 집행 및 제휴 관련 연락처 정보를 안내합니다." canonicalPath="/contact/" pageType="ContactPage" breadcrumbs={breadcrumbs} datePublished={DEFAULT_DATE_PUBLISHED} dateModified={DEFAULT_LASTMOD}>
  <Breadcrumbs items={breadcrumbs} />
  <article class="container readable-content page-hero">
    <span class="eyebrow">광고문의</span>
    <h1>광고문의</h1>
    <p>타로마음 서비스 내 광고 집행, 배너 노출 및 제휴 문의 안내입니다.</p>

    <section class="content-section">
      <h2>배너 광고 및 제휴 문의</h2>
      <p>타로마음 서비스 내 광고 배너 노출, 제휴 제안, 기타 서비스 관련 문의는 아래 메일 주소로 보내주시기 바랍니다.</p>

      <div class="contact-box">
        <div class="contact-email">
          <span class="email-label">이메일 주소:</span>
          <a href={`mailto:${email}`} class="email-link" id="contact-email">{email}</a>
        </div>
        <div class="contact-actions">
          <a href={`mailto:${email}`} class="primary-button">메일 보내기</a>
          <button type="button" class="secondary-button" id="copy-email-btn" data-email={email}>이메일 주소 복사</button>
        </div>
      </div>

      <h2>문의 시 참고 사항</h2>
      <ul>
        <li>희망하시는 광고 유형(상단 배너, 하단 배너 등) 및 희망 게재 기간을 함께 기재해 주시면 보다 빠른 안내가 가능합니다.</li>
        <li>보내주신 문의는 확인 후 영업일 기준 1~2일 이내에 답변드립니다.</li>
        <li>DB 없는 정적 사이트이므로 서버 저장형 문의 폼은 제공하지 않으며, 이메일 발송 시 사용자의 메일 서비스 정책이 적용됩니다.</li>
      </ul>
    </section>
  </article>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = '복사 완료!';
          setTimeout(() => {
            copyBtn.textContent = originalText;
          }, 2000);
        } catch (err) {
          alert('이메일 주소 복사에 실패했습니다: ' + email);
        }
      });
    }
  </script>
</Layout>
