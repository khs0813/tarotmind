---
export type AdPlacement = 'hub-primary' | 'reading-primary' | 'card-index-primary' | 'card-detail-primary';

type Props = {
  placement?: AdPlacement | string;
  locale?: 'ko' | 'en';
  deferUntilVisible?: boolean;
};

const { placement = 'hub-primary', locale = 'ko' } = Astro.props as Props;
---

<section
  class={`ad-slot ad-slot-${placement} coupang-ad-slot`}
  aria-label={locale === 'en' ? 'Affiliate advertising area' : '쿠팡 파트너스 제휴 광고'}
>
  <div class="coupang-ad-inner">
    <div class="coupang-banner-container">
      <script is:inline src="https://ads-partners.coupang.com/g.js"></script>
      <script is:inline>
        new PartnersCoupang.G({"id":999028,"template":"carousel","trackingCode":"AF4791224","width":"680","height":"140","tsource":""});
      </script>
    </div>
    <p class="coupang-disclosure">
      {locale === 'en'
        ? 'This page contains Coupang Partners affiliate links, and we may earn a commission from qualifying purchases.'
        : '이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.'}
    </p>
  </div>
</section>
