---
import { SITE_COPY, type SiteLocale } from '../data/site';
const { locale = 'ko' } = Astro.props as { locale?: SiteLocale; currentPath?: string };
const copy = SITE_COPY[locale];
const footerText = locale === 'en'
  ? {
      description: 'A free AI-style tarot reading site for checking today’s energy and practical advice by drawing cards.',
      disclaimer: 'This content is for entertainment and reflection. For important decisions, use real-world information and qualified professional advice.',
      navLabel: 'Footer menu',
      privacy: 'Privacy',
      terms: 'Terms',
      credits: 'Image Credits',
      contact: 'Contact',
      sitemap: 'Sitemap',
      base: '/en'
    }
  : {
      description: '카드 선택으로 오늘의 흐름과 조언을 가볍게 확인하는 무료 AI 스타일 타로 리딩 사이트입니다.',
      disclaimer: '본 콘텐츠는 오락 및 참고용이며, 중요한 결정은 현실적인 정보와 전문가 조언을 함께 확인하세요.',
      navLabel: '하단 메뉴',
      privacy: '개인정보처리방침',
      terms: '이용약관',
      credits: '이미지 출처',
      contact: '문의',
      sitemap: '사이트맵',
      base: ''
    };
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>{copy.name}</strong>
      <p>{footerText.description}</p>
      <p class="small">{footerText.disclaimer}</p>
    </div>
    <nav aria-label={footerText.navLabel}>
      <a href={`${footerText.base}/privacy/`}>{footerText.privacy}</a>
      <a href={`${footerText.base}/terms/`}>{footerText.terms}</a>
      <a href={`${footerText.base}/credits/`}>{footerText.credits}</a>
      <a href={`${footerText.base}/contact/`}>{footerText.contact}</a>
      <a href={`${footerText.base}/rss.xml`}>RSS</a>
      <a href="/sitemap.xml">{footerText.sitemap}</a>
    </nav>
  </div>
</footer>
