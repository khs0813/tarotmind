---
import '../styles/global.css';
import '../styles/tarot.css';
import '../styles/cards.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import {
  DEFAULT_OG_IMAGE,
  SITE_COPY,
  buildSiteUrl,
  dedupeRepeatedLabel,
  getAlternateUrls,
  getNaverVerification,
  getSiteUrl,
  isSiteUrlConfigured,
  localizePath,
  normalizePath,
  safeJsonLd,
  type BreadcrumbItem,
  type SiteLocale
} from '../data/site';

type Props = {
  title: string;
  description: string;
  canonicalPath: string;
  locale?: SiteLocale;
  keywords?: string[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'Article';
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown>[];
  robots?: string;
  datePublished?: string;
  dateModified?: string;
};

const {
  title,
  description,
  canonicalPath,
  locale = 'ko',
  keywords = [],
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  pageType = 'WebPage',
  breadcrumbs = [],
  jsonLd = [],
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  datePublished,
  dateModified
} = Astro.props as Props;

const siteUrl = getSiteUrl();
const hasConfiguredSiteUrl = isSiteUrlConfigured();
const siteCopy = SITE_COPY[locale];
const normalizedCanonicalPath = normalizePath(canonicalPath);
const canonicalUrl = buildSiteUrl(normalizedCanonicalPath);
const alternates = getAlternateUrls(normalizedCanonicalPath);
const englishPath = localizePath(normalizedCanonicalPath, 'en');
const imageUrl = new URL(ogImage, `${siteUrl}/`).toString();
const rssUrl = new URL(locale === 'en' ? '/en/rss.xml' : '/rss.xml', `${siteUrl}/`).toString();
const naverVerification = getNaverVerification();
const robotsContent = robots;
const uniqueKeywords = [...new Set(keywords.map((keyword) => keyword.trim()).filter(Boolean))];
const keywordContent = uniqueKeywords.join(', ');
const siteId = `${siteUrl}/#website`;
const publisherId = `${siteUrl}/#organization`;
const pageId = `${canonicalUrl}#webpage`;

const publisherLd = {
  '@id': publisherId,
  '@type': 'Organization',
  name: siteCopy.name,
  url: siteUrl,
  logo: imageUrl
};

const organizationLd = {
  '@context': 'https://schema.org',
  ...publisherLd
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@id': pageId,
  '@type': pageType,
  name: title,
  headline: title,
  description,
  url: canonicalUrl,
  inLanguage: siteCopy.schemaLanguage,
  image: imageUrl,
  isPartOf: {
    '@id': siteId,
    '@type': 'WebSite',
    name: siteCopy.name,
    url: siteUrl
  },
  publisher: { '@id': publisherId },
  ...(uniqueKeywords.length > 0 ? { keywords: uniqueKeywords.join(', ') } : {}),
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {})
};

const webSiteLd = normalizedCanonicalPath === '/' ? [{
  '@context': 'https://schema.org',
  '@id': siteId,
  '@type': 'WebSite',
  name: siteCopy.name,
  description: siteCopy.description,
  url: siteUrl,
  inLanguage: siteCopy.schemaLanguage,
  publisher: publisherLd
}] : [];

const breadcrumbLd = breadcrumbs.length > 0 ? [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: dedupeRepeatedLabel(item.name),
    item: buildSiteUrl(item.path)
  }))
}] : [];

const allJsonLd = hasConfiguredSiteUrl ? [organizationLd, ...webSiteLd, webPageLd, ...breadcrumbLd, ...jsonLd] : [];
---
<!doctype html>
<html lang={siteCopy.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordContent && <meta name="keywords" content={keywordContent} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="author" content={siteCopy.name} />
    <meta name="generator" content="Astro" />
    <meta name="format-detection" content="telephone=no" />
    {naverVerification && <meta name="naver-site-verification" content={naverVerification} />}

    <meta property="og:locale" content={siteCopy.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'en' ? SITE_COPY.ko.ogLocale : SITE_COPY.en.ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteCopy.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={siteCopy.imageAlt} />
    {dateModified && <meta property="og:updated_time" content={dateModified} />}
    {ogType === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
    {ogType === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
    {ogType === 'article' && <meta property="article:author" content={siteCopy.name} />}
    {ogType === 'article' && uniqueKeywords.map((keyword) => <meta property="article:tag" content={keyword} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={siteCopy.imageAlt} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteCopy.name} RSS`} href={rssUrl} />
    <link rel="alternate" hreflang="ko-KR" href={alternates.ko} />
    <link rel="alternate" hreflang="en-US" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.en} />

    {allJsonLd.map((item) => <script is:inline type="application/ld+json" set:html={safeJsonLd(item)} />)}
    <script is:inline define:vars={{ currentLocale: locale, englishPath }}>
      (() => {
        const key = 'tarotmind.locale';
        const getPreference = () => {
          try { return window.localStorage.getItem(key); } catch { return null; }
        };
        const setPreference = (value) => {
          try { window.localStorage.setItem(key, value); } catch {}
        };
        const params = new URLSearchParams(window.location.search);
        const requestedLocale = params.get('lang');
        let cleanedSearch = window.location.search;
        if (requestedLocale === 'ko' || requestedLocale === 'en') {
          setPreference(requestedLocale);
          params.delete('lang');
          cleanedSearch = params.toString() ? `?${params.toString()}` : '';
          window.history.replaceState(null, '', `${window.location.pathname}${cleanedSearch}${window.location.hash}`);
        }
        if (currentLocale !== 'ko') return;
        if (requestedLocale === 'ko') return;
        const host = window.location.hostname;
        if (/^(localhost|127\.0\.0\.1|0\.0\.0\.0)$/.test(host)) return;
        const userAgent = window.navigator.userAgent || '';
        if (/(bot|crawl|spider|slurp|yeti|naver|daum|bingpreview)/i.test(userAgent)) return;
        const languages = window.navigator.languages?.length ? window.navigator.languages : [window.navigator.language || ''];
        const hasKoreanLanguage = languages.some((language) => String(language).toLowerCase().startsWith('ko'));
        const hasLanguageSignal = languages.some(Boolean);
        if ((requestedLocale === 'en' || (hasLanguageSignal && !hasKoreanLanguage && getPreference() !== 'ko')) && !window.location.pathname.startsWith('/en/')) {
          window.location.replace(`${englishPath}${cleanedSearch}${window.location.hash}`);
        }
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} currentPath={normalizedCanonicalPath} />
    <main id="content">
      <slot />
    </main>
    <Footer locale={locale} currentPath={normalizedCanonicalPath} />
  </body>
</html>
