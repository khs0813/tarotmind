---
import type { TarotReadingPage } from '../data/tarotReadings';
import { type SiteLocale } from '../data/site';
const { reading, locale = 'ko' } = Astro.props as { reading: TarotReadingPage; locale?: SiteLocale };
const basePath = locale === 'en' ? '/en' : '';
const title = reading.title.split('|')[0].trim();
---
<article class="feature-card">
  <span class="eyebrow">{reading.shortTitle}</span>
  <h3>{title}</h3>
  <p>{reading.summary}</p>
  <a class="card-link" href={`${basePath}/tarot/${reading.slug}/`}>{locale === 'en' ? `Open ${reading.shortTitle} ->` : `${reading.shortTitle} 보기 →`}</a>
</article>
